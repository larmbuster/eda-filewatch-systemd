[Unit]
Description=EDA File Watch Monitor for AAP (%i)
Documentation=https://github.com/user/eda-filewatch-systemd
After=network.target
Wants=network.target

[Service]
Type=simple
# Run as root to access all files
User=root
Group=root
WorkingDirectory=/opt/eda-filewatch
ExecStart=/opt/eda-filewatch/filewatch-monitor.sh
ExecReload=/bin/kill -HUP $MAINPID
# Log output to both journal and file
StandardOutput=append:/var/log/eda-filewatch/%i.log
StandardError=append:/var/log/eda-filewatch/%i.log
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

# Environment configuration
Environment=CONFIG_FILE=/etc/eda-filewatch/%i.conf
Environment=LOG_LEVEL=INFO

# Security settings - balanced for AIDE monitoring
NoNewPrivileges=true
PrivateTmp=false
PrivateDevices=true
# AIDE needs to read files anywhere on the system
ProtectHome=false
ProtectSystem=false
# Allow write access only where needed
ReadWritePaths=/var/log/eda-filewatch /var/lib/aide /tmp /etc/eda-filewatch
# Note: Running as root with full read access is required for AIDE to monitor any file

# Resource limits
LimitNOFILE=1024
LimitNPROC=32

[Install]
WantedBy=multi-user.target 